APP_ENV=local
GIT_SHA=dev
AUTH_MODE=header
CORS_ORIGINS=*

PORTAL_DATABASE_URL=postgresql://portal:portal@portal-db:5432/portal

COSDRIVE_ENABLED=true
COSDRIVE_ALLOWED_PREFIXES=/交付/,/团队共享/,/存档/
COSDRIVE_JOB_DIR=/tmp/cosdrive_jobs
COSDRIVE_DISPATCH_MODE=local-process

SMH_ENABLED=false
SMH_APP_ID=
SMH_ORG_ID=
SMH_LIBRARY_ID=
SMH_PRIVATE_KEY_FILE=
SMH_COUNTRY_CODE=+86
SMH_PHONE_NUMBER=
SMH_TOKEN_TTL_SECONDS=300
SMH_API_BASE_PUBLIC=https://api.tencentsmh.cn
SMH_API_BASE_APP=https://api.tencentsmh.cn/api/v1

PREFECT_UI_BASE_URL=
LEGEND_APP_ROOT=/home/rocio/projects/smartOps
