# Control Plane — environment variables (copy to .env and fill in)

# Runtime environment label (development / staging / production)
ENV=development

# Database
# Path is relative to the directory uvicorn is launched from.
DATABASE_URL=sqlite+aiosqlite:///./control_plane.db
# Phase 3 MySQL local compose option:
# DATABASE_URL=mysql+asyncmy://control_plane:control_plane@localhost:3306/control_plane?charset=utf8mb4

# S3-compatible object storage (used by 1.6 upload service).
# Default values target the local MinIO container started by deploy/docker-compose.yml (task 1.16).
# In production, point S3_ENDPOINT_URL at AWS S3 / Aliyun OSS / Tencent COS endpoint and rotate credentials.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=auto-upload-dev
STAGING_BUCKET_NAME=auto-upload-staging
S3_REGION=us-east-1
# MinIO dev defaults — MUST be replaced with real credentials in any non-local environment.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Worker concurrency (used by 1.8 task_runner)
WORKER_MAX_TARGET_CONCURRENT=3
WORKER_MAX_FILE_CONCURRENT=5
WORKER_AUTO_ADJUST_CONCURRENT=true

# Task working directory (zip extraction; used by 1.5 / 1.8)
TASK_DIR_BASE=/tmp/auto_upload_tasks

# Data-plane source mode (Phase 3): file keeps local temp_dir compatibility;
# object stages original.zip to STAGING_BUCKET_NAME and emits source reference.
DELIVERY_SOURCE_MODE=file

# Redis capability layer (Phase 4)
REDIS_URL=redis://localhost:6379/0
# Set to redis for cross-instance SSE progress fanout.
PROGRESS_BACKEND=memory
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_HEALTHCHECK_ENABLED=false
REDIS_IDEMPOTENCY_ENABLED=false
REDIS_IDEMPOTENCY_TTL_SECONDS=60
REDIS_LEASE_ENABLED=false
REDIS_LEASE_TTL_SECONDS=30

# Classification profile (used by 1.5 classifier)
CLASSIFICATION_PROFILE_PATH=../profiles/hq_subsidiary_reports_v1/profile.json

# Limits enforced when receiving zip (used by 1.5 / 1.9)
MAX_ZIP_BYTES=524288000          # 500 MB
MAX_UNZIPPED_BYTES=1073741824    # 1 GB
MAX_FILE_COUNT=5000

# CORS allowed origins (used by 1.9 / main.py)
# Use "*" to allow all, or comma-separated list: http://a.com,http://b.com
CORS_ORIGINS=*
